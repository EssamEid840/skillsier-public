# Application Configuration
USERS_BE_APP_NAME=users-be
USERS_BE_APP_VERSION=1.0.0
USERS_BE_APP_ENVIRONMENT=development
# USERS_BE_APP_PORT=8080
USERS_BE_APP_LOG_LEVEL=info

# Server Configuration
USERS_BE_SERVER_PORT=8080
USERS_BE_SERVER_ENABLE_CORS=true

# Database Configuration
USERS_BE_DATABASE_HOST=173.212.218.251
USERS_BE_DATABASE_PORT=30433
USERS_BE_DATABASE_NAME=usersdb
USERS_BE_DATABASE_USER=usersuser
USERS_BE_DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION
USERS_BE_DATABASE_SSL_MODE=disable
USERS_BE_DATABASE_MAX_OPEN_CONNS=25
USERS_BE_DATABASE_MAX_IDLE_CONNS=5
USERS_BE_DATABASE_CONN_MAX_LIFETIME=5m
USERS_BE_DATABASE_AUTO_MIGRATE=true
USERS_BE_DATABASE_ALLOW_IN_PRODUCTION=false

# Migration Configuration
USERS_BE_MIGRATION_ENABLED=true
USERS_BE_MIGRATION_ALLOW_IN_PRODUCTION=false
USERS_BE_MIGRATION_ALLOW_DESTRUCTIVE=false
USERS_BE_MIGRATION_LOG_SUMMARY=true


# Kafka Configuration
USERS_BE_KAFKA_BROKERS=localhost:9092
USERS_BE_KAFKA_SECURITY_PROTOCOL=SASL_SSL
USERS_BE_KAFKA_ENABLE_SASL=true
USERS_BE_KAFKA_ENABLE_TLS=false
# USERS_BE_KAFKA_SASL_USERNAME=users-be
# USERS_BE_KAFKA_SASL_PASSWORD=your-kafka-password
USERS_BE_KAFKA_SASL_USERNAME=admin-user
USERS_BE_KAFKA_SASL_PASSWORD=
USERS_BE_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
USERS_BE_KAFKA_TLS_SKIP_VERIFY=false
USERS_BE_KAFKA_CONSUMER_GROUP=users-be-group
USERS_BE_KAFKA_TOPIC_PREFIX=users
USERS_BE_KAFKA_PRODUCER_REQUIRED_ACKS=-1
USERS_BE_KAFKA_PRODUCER_MAX_MESSAGE_BYTES=1000000
USERS_BE_KAFKA_PRODUCER_COMPRESSION=snappy
USERS_BE_KAFKA_PRODUCER_IDEMPOTENT_WRITES=true
USERS_BE_KAFKA_PRODUCER_MAX_RETRIES=5
USERS_BE_KAFKA_PRODUCER_RETRY_BACKOFF=100ms
USERS_BE_KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false
USERS_BE_KAFKA_CONSUMER_AUTO_COMMIT_INTERVAL=1s
USERS_BE_KAFKA_CONSUMER_SESSION_TIMEOUT=10s
USERS_BE_KAFKA_CONSUMER_FETCH_MIN_BYTES=1
USERS_BE_KAFKA_CONSUMER_FETCH_MAX_WAIT=500ms
USERS_BE_KAFKA_CONSUMER_MAX_PROCESSING_TIME=30s

# Keycloak Configuration
USERS_BE_KEYCLOAK_URL=http://localhost:8080
USERS_BE_KEYCLOAK_REALM=skillsier
USERS_BE_KEYCLOAK_CLIENT_ID=users-be
# USERS_BE_KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
USERS_BE_KEYCLOAK_CLIENT_SECRET=
USERS_BE_KEYCLOAK_TIMEOUT=10s
USERS_BE_KEYCLOAK_JWKS_CACHE_TTL=24h

# Dapr Configuration
USERS_BE_DAPR_ENABLED=false
USERS_BE_DAPR_HTTP_PORT=3500
USERS_BE_DAPR_GRPC_PORT=50001
USERS_BE_DAPR_PUBSUB_NAME=kafka-pubsub
USERS_BE_DAPR_STATE_STORE_NAME=statestore

# Outbox Configuration
USERS_BE_OUTBOX_ENABLED=true
USERS_BE_OUTBOX_POLL_INTERVAL=5s
USERS_BE_OUTBOX_BATCH_SIZE=100
USERS_BE_OUTBOX_MAX_RETRIES=5
USERS_BE_OUTBOX_RETRY_BACKOFF=5s

# K8S SECRET FETCHING NOTES:
# 1. Database password:
#    export USERS_BE_DATABASE_PASSWORD=$(kubectl get secret users-be-postgres -n skillsier -o jsonpath='{.data.POSTGRES_PASSWORD}' | base64 -d)
# 2. Kafka password:
#    export USERS_BE_KAFKA_SASL_PASSWORD=$(kubectl get secret admin-user -n kafka -o jsonpath='{.data.password}' | base64 -d)
# 3. Keycloak client secret:
#    export USERS_BE_KEYCLOAK_CLIENT_SECRET=$(kubectl get secret keycloak-client-users-be -n keycloak -o jsonpath='{.data.client-secret}' | base64 -d)
# Or use: source scripts/get-secrets.sh