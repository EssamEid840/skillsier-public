#!/bin/bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_step() { echo -e "${BLUE}==>${NC} $1"; }

usage() {
  cat <<EOF
Usage: $0 <service-name> [options]

Arguments:
  service-name    Name of the service (e.g., jobs, proposals, contracts)

Options:
  --port PORT          Service port (default: 8080)
  --db-port PORT       Database port (default: 5432)
  --module MODULE      Go module path (default: skillsier.dev/apps/be/<service>-be)
  --output-dir DIR     Output directory (default: ../<service>-be)
  --help              Show this help message

Examples:
  $0 jobs
  $0 proposals --port 8081
  $0 contracts --port 8082 --output-dir /path/to/output
EOF
  exit 1
}

if [[ $# -lt 1 ]] || [[ "$1" == "--help" ]]; then
  usage
fi

SERVICE_NAME="$1"
shift

SERVICE_PORT="8080"
DB_PORT="5432"
GO_MODULE=""
OUTPUT_DIR="../${SERVICE_NAME}-be"

while [[ $# -gt 0 ]]; do
  case $1 in
    --port)
      SERVICE_PORT="$2"
      shift 2
      ;;
    --db-port)
      DB_PORT="$2"
      shift 2
      ;;
    --module)
      GO_MODULE="$2"
      shift 2
      ;;
    --output-dir)
      OUTPUT_DIR="$2"
      shift 2
      ;;
    *)
      log_error "Unknown option: $1"
      usage
      ;;
  esac
done

if [[ ! "$SERVICE_NAME" =~ ^[a-z][a-z0-9-]*$ ]]; then
  log_error "Service name must be lowercase alphanumeric with hyphens (kebab-case)"
  exit 1
fi

SERVICE_UPPER=$(echo "$SERVICE_NAME" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
SERVICE_PASCAL=$(echo "$SERVICE_NAME" | sed -r 's/(^|-)([a-z])/\U\2/g')
DB_NAME="${SERVICE_NAME//-/}db"
DB_USER="${SERVICE_NAME//-/}user"
GO_MODULE="${GO_MODULE:-skillsier.dev/apps/be/${SERVICE_NAME}-be}"
DOCKER_IMAGE="skillsier/${SERVICE_NAME}-be:latest"

log_step "Instantiating template for service: $SERVICE_NAME"
echo ""
log_info "Configuration:"
log_info "  Service (kebab):    $SERVICE_NAME"
log_info "  Service (UPPER):    $SERVICE_UPPER"
log_info "  Service (Pascal):   $SERVICE_PASCAL"
log_info "  Go Module:          $GO_MODULE"
log_info "  Database Name:      $DB_NAME"
log_info "  Database User:      $DB_USER"
log_info "  Service Port:       $SERVICE_PORT"
log_info "  DB Port:            $DB_PORT"
log_info "  Docker Image:       $DOCKER_IMAGE"
log_info "  Output Directory:   $OUTPUT_DIR"
echo ""

if [[ -d "$OUTPUT_DIR" ]]; then
  log_warn "Output directory already exists: $OUTPUT_DIR"
  read -p "Do you want to overwrite it? (yes/no): " -r
  if [[ ! $REPLY =~ ^yes$ ]]; then
    log_info "Cancelled"
    exit 0
  fi
  rm -rf "$OUTPUT_DIR"
fi

log_step "Copying template files..."
cp -r "$(dirname "$0")/.." "$OUTPUT_DIR"
cd "$OUTPUT_DIR"

rm -f "scripts/instantiate-template"

log_step "Replacing tokens..."

replace_tokens() {
  local file="$1"
  
  if [[ $(file -b --mime-encoding "$file") == "binary" ]] || [[ "$file" == *".git"* ]]; then
    return
  fi
  
  sed -i "s|<service>|${SERVICE_NAME}|g" "$file"
  sed -i "s|<SERVICE>|${SERVICE_UPPER}|g" "$file"
  sed -i "s|<Service>|${SERVICE_PASCAL}|g" "$file"
  sed -i "s|<module>|${GO_MODULE}|g" "$file"
  sed -i "s|<db_name>|${DB_NAME}|g" "$file"
  sed -i "s|<db_user>|${DB_USER}|g" "$file"
  sed -i "s|<service_port>|${SERVICE_PORT}|g" "$file"
  sed -i "s|<topic_prefix>|${SERVICE_NAME}|g" "$file"
  sed -i "s|<docker_image>|${DOCKER_IMAGE}|g" "$file"
  sed -i "s|<k8s_namespace>|skillsier|g" "$file"
  sed -i "s|<keycloak_realm>|skillsier|g" "$file"
  sed -i "s|<keycloak_client_id>|${SERVICE_NAME}-be|g" "$file"
  sed -i "s|<postgres_dsn>|postgres://${DB_USER}:PASSWORD@localhost:${DB_PORT}/${DB_NAME}?sslmode=disable|g" "$file"
  sed -i "s|<kafka_brokers>|localhost:9092|g" "$file"
}

find . -type f -not -path "*/\.git/*" | while read -r file; do
  replace_tokens "$file"
done

log_step "Renaming directories..."
if [[ -d "contracts/events/initialentity" ]]; then
  mv "contracts/events/initialentity" "contracts/events/${SERVICE_NAME}entity"
fi

log_step "Updating go.mod..."
if [[ -f "go.mod" ]]; then
  sed -i "1s|.*|module ${GO_MODULE}|" go.mod
fi

log_step "Making scripts executable..."
chmod +x scripts/*.sh 2>/dev/null || true

# log_step "Running go mod tidy..."
# go mod tidy


log_step "Adding local replace for skillsier.dev/contracts/events..."
# relative path from generated service to the local contracts/events folder
CONTRACTS_EVENTS_REL_PATH="../contracts/events"
go mod edit -replace=skillsier.dev/contracts/events=$CONTRACTS_EVENTS_REL_PATH

CONTRACTS_AUTH_REL_PATH="../pkg/auth"
go mod edit -replace=skillsier.dev/pkg/auth=$CONTRACTS_AUTH_REL_PATH

CONTRACTS_PLATFORM_SHARED_REL_PATH="../platform-shared"
go mod edit -replace=skillsier.dev/platform-shared=$CONTRACTS_PLATFORM_SHARED_REL_PATH

log_step "Tidying go.mod again after replace..."
go mod tidy


echo ""
log_info "✓ Template instantiation complete!"
echo ""
log_info "Next steps:"
log_info "  1. cd $OUTPUT_DIR"
log_info "  2. Review and customize the generated code"
log_info "  3. Update internal/domain/${SERVICE_NAME}entity/ with your domain logic"
log_info "  4. Update contracts/events/${SERVICE_NAME}entity/v1/ with your event schemas"
log_info "  5. Run: make deps"
log_info "  6. Run: make run-local"
echo ""