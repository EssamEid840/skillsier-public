# Application Configuration
<SERVICE>_BE_APP_NAME=<service>-be
<SERVICE>_BE_APP_ENVIRONMENT=development
<SERVICE>_BE_APP_PORT=<service_port>
<SERVICE>_BE_APP_LOG_LEVEL=info

# Database Configuration
<SERVICE>_BE_DATABASE_HOST=localhost
<SERVICE>_BE_DATABASE_PORT=5432
<SERVICE>_BE_DATABASE_USER=<db_user>
<SERVICE>_BE_DATABASE_DATABASE=<db_name>
<SERVICE>_BE_DATABASE_SSL_MODE=disable
<SERVICE>_BE_DATABASE_MAX_OPEN_CONNS=25
<SERVICE>_BE_DATABASE_MAX_IDLE_CONNS=5
<SERVICE>_BE_DATABASE_CONN_MAX_LIFETIME=30
<SERVICE>_BE_DATABASE_PASSWORD=
<SERVICE>_BE_DATABASE_AUTO_MIGRATE=true
<SERVICE>_BE_DATABASE_ALLOW_IN_PRODUCTION=false

# Kafka Configuration
<SERVICE>_BE_KAFKA_BROKERS=localhost:9092
<SERVICE>_BE_KAFKA_SECURITY_PROTOCOL=SASL_SSL
<SERVICE>_BE_KAFKA_SASL_USERNAME=admin-user
<SERVICE>_BE_KAFKA_SASL_PASSWORD=
<SERVICE>_BE_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
<SERVICE>_BE_KAFKA_TLS_SKIP_VERIFY=false
<SERVICE>_BE_KAFKA_CONSUMER_GROUP=<service>-be-group
<SERVICE>_BE_KAFKA_TOPIC_PREFIX=<service>
<SERVICE>_BE_KAFKA_PRODUCER_REQUIRED_ACKS=-1
<SERVICE>_BE_KAFKA_PRODUCER_MAX_MESSAGE_BYTES=1000000
<SERVICE>_BE_KAFKA_PRODUCER_COMPRESSION=snappy
<SERVICE>_BE_KAFKA_PRODUCER_IDEMPOTENT_WRITES=true
<SERVICE>_BE_KAFKA_PRODUCER_MAX_RETRIES=5
<SERVICE>_BE_KAFKA_PRODUCER_RETRY_BACKOFF=100ms
<SERVICE>_BE_KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false
<SERVICE>_BE_KAFKA_CONSUMER_AUTO_COMMIT_INTERVAL=1s
<SERVICE>_BE_KAFKA_CONSUMER_SESSION_TIMEOUT=10s
<SERVICE>_BE_KAFKA_CONSUMER_FETCH_MIN_BYTES=1
<SERVICE>_BE_KAFKA_CONSUMER_FETCH_MAX_WAIT=500ms
<SERVICE>_BE_KAFKA_CONSUMER_MAX_PROCESSING_TIME=30s

# Keycloak Configuration
<SERVICE>_BE_KEYCLOAK_URL=http://localhost:8080
<SERVICE>_BE_KEYCLOAK_REALM=skillsier
<SERVICE>_BE_KEYCLOAK_CLIENT_ID=<service>-be
<SERVICE>_BE_KEYCLOAK_CLIENT_SECRET=
<SERVICE>_BE_KEYCLOAK_TIMEOUT=10s
<SERVICE>_BE_KEYCLOAK_JWKS_CACHE_TTL=24h

# Dapr Configuration
<SERVICE>_BE_DAPR_ENABLED=false
<SERVICE>_BE_DAPR_HTTP_PORT=3500
<SERVICE>_BE_DAPR_GRPC_PORT=50001
<SERVICE>_BE_DAPR_PUBSUB_NAME=kafka-pubsub
<SERVICE>_BE_DAPR_STATE_STORE_NAME=statestore

# Outbox Configuration
<SERVICE>_BE_OUTBOX_ENABLED=true
<SERVICE>_BE_OUTBOX_POLL_INTERVAL=5s
<SERVICE>_BE_OUTBOX_BATCH_SIZE=100
<SERVICE>_BE_OUTBOX_MAX_RETRIES=5
<SERVICE>_BE_OUTBOX_RETRY_BACKOFF=5s

# K8S SECRET FETCHING NOTES:
# 1. Database password:
#    export <SERVICE>_BE_DATABASE_PASSWORD=$(kubectl get secret <service>-be-postgres -n skillsier -o jsonpath='{.data.POSTGRES_PASSWORD}' | base64 -d)
# 2. Kafka password:
#    export <SERVICE>_BE_KAFKA_SASL_PASSWORD=$(kubectl get secret admin-user -n kafka -o jsonpath='{.data.password}' | base64 -d)
# 3. Keycloak client secret:
#    export <SERVICE>_BE_KEYCLOAK_CLIENT_SECRET=$(kubectl get secret keycloak-client-<service>-be -n keycloak -o jsonpath='{.data.client-secret}' | base64 -d)
# Or use: source scripts/get-secrets.sh