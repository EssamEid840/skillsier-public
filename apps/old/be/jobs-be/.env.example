# Application Configuration
JOBS_BE_APP_NAME=jobs-be
JOBS_BE_APP_ENVIRONMENT=development
JOBS_BE_APP_PORT=8081
JOBS_BE_APP_LOG_LEVEL=info

# Database Configuration
JOBS_BE_DATABASE_HOST=173.212.218.251
JOBS_BE_DATABASE_PORT=30432
JOBS_BE_DATABASE_USER=jobsuser
JOBS_BE_DATABASE_DATABASE=jobsdb
JOBS_BE_DATABASE_SSL_MODE=disable
JOBS_BE_DATABASE_MAX_OPEN_CONNS=25
JOBS_BE_DATABASE_MAX_IDLE_CONNS=5
JOBS_BE_DATABASE_CONN_MAX_LIFETIME=30

# Database Password (fetch from K8s secret)
DB_PASSWORD=

# Kafka Configuration
JOBS_BE_KAFKA_BROKERS=173.212.218.251:31691
JOBS_BE_KAFKA_SASL_USERNAME=admin-user
JOBS_BE_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
JOBS_BE_KAFKA_SECURITY_PROTOCOL=SASL_SSL
JOBS_BE_KAFKA_SKIP_VERIFY=true
JOBS_BE_KAFKA_CONSUMER_GROUP=jobs-be-group
JOBS_BE_KAFKA_JOB_EVENTS_TOPIC=job-events

# Kafka Password (fetch from K8s secret)
KAFKA_PASSWORD=

# Keycloak Configuration
JOBS_BE_KEYCLOAK_URL=https://keycloak.skillsier.com
JOBS_BE_KEYCLOAK_REALM=skillsier
KEYCLOAK_CLIENT_ID=jobs-be
KEYCLOAK_CLIENT_SECRET=

# Dapr Configuration
JOBS_BE_DAPR_ENABLED=true
JOBS_BE_DAPR_HTTP_PORT=3500
JOBS_BE_DAPR_GRPC_PORT=50001
JOBS_BE_DAPR_PUBSUB_NAME=kafka-pubsub
JOBS_BE_DAPR_STATE_STORE_NAME=statestore
