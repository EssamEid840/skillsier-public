# Node Environment
NODE_ENV=development

# API Configuration
API_BASE_URL=http://localhost:8080

# Authentication
AUTH_PROVIDER=dev
NEXTAUTH_SECRET=your-secret-here-min-32-chars-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Keycloak (when AUTH_PROVIDER=keycloak)
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/skillsier
KEYCLOAK_CLIENT_ID=skillsier-web
KEYCLOAK_CLIENT_SECRET=

# Dev Auth Seeded Accounts
DEV_ADMIN_EMAIL=admin@skillsier.dev
DEV_ADMIN_PASSWORD=admin123
DEV_CLIENT_EMAIL=client@skillsier.dev
DEV_CLIENT_PASSWORD=client123
DEV_FREELANCER_EMAIL=freelancer@skillsier.dev
DEV_FREELANCER_PASSWORD=freelancer123

# App Configuration
NEXT_PUBLIC_APP_NAME=Skillsier
NEXT_PUBLIC_APP_URL=http://localhost:3000
