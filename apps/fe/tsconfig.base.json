{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@skillsier/ui": ["packages/ui/src"],
      "@skillsier/sdk": ["packages/sdk/src"],
      "@skillsier/types/*": ["packages/types/src/*"],
      "@skillsier/i18n": ["packages/i18n/src"],
      "@skillsier/analytics": ["packages/analytics/src"],
      "@skillsier/flags": ["packages/flags/src"],
      "@skillsier/platform/*": ["packages/platform/*"],
      "@skillsier/state": ["packages/state/src"],
      "@skillsier/auth": ["packages/auth/src"]
    }
  }
}
