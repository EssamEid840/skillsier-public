# ============================================
# apps/web/.env.local.example
# ============================================
# Copy this to .env.local and fill in the values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Keycloak Configuration (Production)
NEXT_PUBLIC_KEYCLOAK_URL=https://keycloak.skillsier.com
NEXT_PUBLIC_KEYCLOAK_REALM=skillsier
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=skillsier-fe

# Server-side Keycloak Configuration
KEYCLOAK_ISSUER_URL=https://keycloak.skillsier.com/realms/skillsier
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Management Client (for registration APIs)
KEYCLOAK_MGMT_CLIENT_ID=skillsier-bff
KEYCLOAK_MGMT_CLIENT_SECRET=your-mgmt-client-secret-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# apps/mobile/.env.example
# ============================================
# Copy this to .env and fill in the values

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Keycloak Configuration (Production)
EXPO_PUBLIC_KEYCLOAK_URL=https://keycloak.skillsier.com
EXPO_PUBLIC_KEYCLOAK_REALM=skillsier
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=skillsier-mobile

# App Configuration
EXPO_PUBLIC_APP_NAME=Skillsier

# ============================================
# For Kubernetes deployment, update these:
# ============================================

# apps/web/.env.local (Kubernetes)
NEXT_PUBLIC_API_URL=http://users-be-service.default.svc.cluster.local:8080/api
NEXT_PUBLIC_APP_URL=https://skillsier.com

# apps/mobile/.env (Kubernetes)
EXPO_PUBLIC_API_URL=https://api.skillsier.com/api